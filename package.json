{
  "name": "marker-navigation",
  "author": "lumine-code",
  "description": "Show navigation headers on the scrollbar and minimap.",
  "repository": "https://github.com/lumine-code/marker-navigation",
  "bugs": {
    "url": "https://github.com/lumine-code/marker-navigation/issues"
  },
  "keywords": [
    "overview-ruler",
    "gutter",
    "annotation",
    "decoration",
    "scrollmap",
    "minimap",
    "header",
    "outline"
  ],
  "version": "1.1.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "navigation.headers": {
      "versions": {
        "^1.0.0": "consumeNavigationHeaders"
      }
    }
  },
  "providedServices": {
    "marker.layer": {
      "versions": {
        "1.0.0": "provideMarkerLayer"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "configSchema": {
    "threshold": {
      "title": "Threshold",
      "description": "Hide markers if count exceeds this value. Zero means no limit.",
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "maxDepth": {
      "title": "Max depth",
      "description": "Maximum header depth to display. Zero means no limit.",
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  }
}
